# Copy this file to .env and replace the checkpoint value with an absolute path.
# Forward slashes are recommended for Docker Desktop on Windows.
ORALLENS_MODEL_CHECKPOINT_PATH=C:/absolute/path/to/OralLens/ml/runs/detection/orthodontic_plaque_part2_mvp_v4_originals_online_aug/checkpoint_best.pt

# Browser-facing local URLs. These values are not secrets.
ORALLENS_FRONTEND_ORIGIN=http://localhost:8080
ORALLENS_API_BASE_URL=http://localhost:8000
ORALLENS_FRONTEND_PORT=8080
ORALLENS_BACKEND_PORT=8000
